async function getWeatherForecast() {
  const apiKey = "f1e00819efb989629341b42dd5028e76";
  const lat = -29.31; // Maseru latitude
  const lon = 27.48;  // Maseru longitude
  const url = https://api.openweathermap.org/data/2.5/forecast?lat=${lat}&lon=${lon}&appid=${f1e00819efb989629341b42dd5028e76}&units=metric;

  const response = await fetch(url);
  const data = await response.json();

  const next3h = data.list[0]; // forecast for next 3 hours
  return {
    rainChance: Math.round(next3h.pop * 100),
    rainAmount: next3h.rain ? next3h.rain["3h"] || 0 : 0,
    condition: next3h.weather[0].main,
    temperatureForecast: next3h.main.temp
  };
}